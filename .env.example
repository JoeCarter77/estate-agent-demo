# ── NOVUS internal (Milestone 1) ──────────────────────────────────────────────
# These are SERVER-SIDE ONLY. Never expose them to the browser.
# Set them in the Vercel project (Settings → Environment Variables).
#
# GOOGLE SHEETS AUTH IS KEYLESS — no service-account JSON key exists or is used
# (the GCP org policy iam.managed.disableServiceAccountKeyCreation forbids key
# creation, and this design doesn't need one). Vercel's own OIDC token is
# federated through Google Workload Identity Federation and exchanged for a
# short-lived token impersonating the novus-sheets service account. This means:
#   1) OIDC Federation must be turned ON for this Vercel project (Project
#      Settings → Security → OIDC Federation). Vercel then injects a short-lived
#      VERCEL_OIDC_TOKEN into every function invocation automatically — it is
#      NOT something you set yourself, and it only exists inside a real Vercel
#      invocation (Production/Preview), never on a local machine.
#   2) The GCP-side Workload Identity Pool + Provider (trusting Vercel's OIDC
#      issuer) and the roles/iam.workloadIdentityUser binding on novus-sheets
#      must already exist — see the NOVUS WIF setup notes for the exact
#      gcloud commands.

# Full resource name of the Workload Identity Pool Provider that trusts Vercel's
# OIDC issuer, e.g.:
#   //iam.googleapis.com/projects/<PROJECT_NUMBER>/locations/global/workloadIdentityPools/vercel-pool/providers/vercel-novus-provider
GCP_WORKLOAD_IDENTITY_AUDIENCE=

# The dedicated service account impersonated for all Sheets access. No key.
# Must be shared as Editor on NOVUS_Data_V1_Master_v2, and must grant
# roles/iam.workloadIdentityUser to the scoped WIF principalSet above.
GCP_SERVICE_ACCOUNT_EMAIL=novus-sheets@first-metric-505115-n3.iam.gserviceaccount.com

# Spreadsheet id of NOVUS_Data_V1_Master_v2
NOVUS_SHEET_ID=1qCw6HxTyhgxNk9inlYzXxvN1Hjkh7sFwFFnlaEWirRA

# Probe identity attached to every probe automatically.
NOVUS_PROBE_EMAIL=novusprobes@gmail.com
NOVUS_PROBE_PHONE=+447575333064

# ---------------------------------------------------------------------------
# AUTONOMOUS PROBE OPERATOR (worker/). LOCAL ONLY — none of these belong in
# Vercel. The worker is a Node process on the operator's own laptop; it drives
# the existing Prober UI in a real browser and adds no serverless function.
#
# The identity below must match what api/novus/probe.js stamps onto the PROBES
# row. The operator refuses to mark a probe as sent when the Probe ready screen
# shows a different email from the one the Rightmove enquiry actually used.
NOVUS_PROBE_FIRST_NAME=
NOVUS_PROBE_LAST_NAME=
NOVUS_PROBE_POSTCODE=

# Bearer token the Prober's Autonomous probing panel must present. Generate a
# long random string; the worker listens on loopback and refuses without it.
NOVUS_OPERATOR_TOKEN=

# Loopback control port the panel talks to (default 8787).
NOVUS_OPERATOR_PORT=8787

# LIVE SUBMISSION IS OFF BY DEFAULT. Unset, the worker performs the whole
# workflow and stops short of clicking Send on the Rightmove enquiry: nothing
# leaves and no probe is created. Set to 1 only once a live run is authorised,
# and pin the first live run to one agency with the allowlist below.
NOVUS_OPERATOR_LIVE_SUBMIT=
NOVUS_OPERATOR_ALLOWED_AGENCIES=

# Run controls and browser. Headless is off by default so the run is watchable
# and so a CAPTCHA can be handed straight to the human.
NOVUS_OPERATOR_BATCH=5
NOVUS_OPERATOR_DAILY_LIMIT=25
NOVUS_OPERATOR_HEADLESS=
NOVUS_OPERATOR_CHANNEL=chrome

# Model used only when a listing type is unreadable or a page is unrecognised.
# Every call is metered and shown in the Prober panel.
NOVUS_OPERATOR_AI=1
NOVUS_OPERATOR_AI_MODEL=claude-sonnet-5

# Basic Auth for the internal /novus UI + /api/novus endpoints (human access).
NOVUS_BASIC_AUTH_USER=novus
NOVUS_BASIC_AUTH_PASS=change-me-to-something-strong

# NeverBounce server-side API key for POST /api/novus/contacts/verify.
# Set in Vercel Environment Variables; never prefix this with a client-exposed
# variable name and never place it in browser code.
NEVERBOUNCE_API_KEY=

# Hunter.io server-side API key for Domain Search, Email Finder and Email Verifier used by
# POST /api/novus/contacts/resolve. Finder results carry their own Hunter
# verification; addresses from Sheets are checked with Hunter Email Verifier.
# Server-side only, same as above.
HUNTER_API_KEY=

# The exact public base URL Twilio (and the email adapter, if ever needed)
# will POST to, e.g. https://estate-agent-demo.vercel.app — no trailing slash.
# Used to reconstruct the exact URL for Twilio request-signature verification.
# If unset, falls back to the request's forwarded-host headers.
NOVUS_PUBLIC_BASE_URL=

# ── NOVUS Communications Milestone 1 (email ingestion) ────────────────────────
# Shared secret for the email adapter (e.g. a Make scenario watching
# joe.novus2@gmail.com) to POST canonical events to
# /api/novus/webhooks/email-inbound. This is INTENTIONALLY separate from
# NOVUS_BASIC_AUTH_* — that middleware already excludes /api/novus/webhooks/*,
# since webhook callers are verified by a shared secret/signature, not the
# human password. The adapter must send it as the X-Novus-Ingest-Secret header.
NOVUS_INGEST_SECRET=change-me-to-something-strong

# ── NOVUS Communications Layer — Twilio voice/SMS (+447575333064) ─────────────
# The dedicated NOVUS number's Account SID and Auth Token (Console → Account).
# TWILIO_AUTH_TOKEN is the ONLY authentication for /api/novus/webhooks/voice-*
# and /api/novus/webhooks/sms-inbound — Twilio signs every request with it
# (X-Twilio-Signature); there is no human password and no separate ingest
# secret on these routes, same pattern as the email webhook using its own
# secret instead of NOVUS_BASIC_AUTH.
#
# NOTE: this code does not configure the Twilio Console webhook URLs itself —
# that is a deliberate separate step. Once ready, point the number's Voice and
# Messaging webhooks at:
#   https://<your-domain>/api/novus/webhooks/voice-inbound   (Voice, A CALL COMES IN)
#   https://<your-domain>/api/novus/webhooks/sms-inbound     (Messaging, A MESSAGE COMES IN)
# With browser calling configured (below), voice-inbound rings the open NOVUS
# page with the matched lead attached (incoming callback recognition —
# lib/calling-inbound.mjs); its <Dial> action /api/novus/webhooks/voice-inbound-action
# is a vercel.json rewrite and needs NOVUS_PUBLIC_BASE_URL. Unanswered calls
# still go to the voicemail prompt as before.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+447575333064

# ── NOVUS Calling — browser outbound calls (novus/calling.html) ───────────────
# Browser calling is OPTIONAL: when any of these is missing, Calling Mode runs
# in manual mode (you dial on a phone, NOVUS keeps time and logs the outcome)
# and GET ?novus_operation=twilio-token tells the page exactly which are absent.
#
# 1. Console → Account → API keys & tokens → Create API key (Standard). The SID
#    and secret sign the short-lived browser access tokens. The secret is
#    shown once; it is never sent to the browser.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# 2. Console → Voice → TwiML Apps → Create. Set its Voice "Request URL" to
#      https://<NOVUS_PUBLIC_BASE_URL>/api/novus/webhooks/voice-outbound   (HTTP POST)
#    The status and recording callbacks are set by the TwiML itself:
#      /api/novus/webhooks/voice-outbound-status
#      /api/novus/webhooks/voice-outbound-recording
#    All three are verified with TWILIO_AUTH_TOKEN (X-Twilio-Signature) and
#    need NOVUS_PUBLIC_BASE_URL to be set to the exact public origin.
#    Also switch on Voice → Settings → "Enforce HTTP Auth on media URLs":
#    NOVUS stores only RecordingSids and plays recordings through its own
#    Basic-Auth proxy, so the raw media URLs should not be publicly playable.
TWILIO_TWIML_APP_SID=
# 3. The number the prospect sees. Either a Twilio number on this account or
#    your own mobile added under Console → Phone Numbers → Verified Caller IDs.
#    E.164, e.g. +447700900123.
TWILIO_CALLER_ID=

# ── NOVUS outbound sending identities (Instantly) ─────────────────────────────
# Comma-separated list of EVERY Instantly sending inbox NOVUS sends from, e.g.
#   NOVUS_SENDING_MAILBOXES=joe@novushq.co.uk,joe@trynovus.co.uk
#
# WHAT IT IS USED FOR. lib/reply-router.mjs uses it as the FALLBACK NOVUS-side
# address when deciding whether a message is inbound or outbound. Per-message
# `eaccount` from Instantly always wins where it is present; this list is what
# direction detection falls back to when it is not, and it is also the
# authenticity gate for the quoted-history thread-context fallback.
#
# WHY IT MATTERS NOW. The code default (DEFAULT_NOVUS_MAILBOXES) lists only two
# addresses. Production sends from four. An address missing from this list means
# a message from that inbox can fail the direction check (UNKNOWN rather than
# OUTBOUND) and its quoted parent is discarded. Unset in this repo and not
# visible in any checked-in deployment config — it must be set in the Vercel
# Production environment to ALL FOUR live outbound inboxes.
#
# Server-side only. Not a secret, but not browser-exposed either.
NOVUS_SENDING_MAILBOXES=

# ── NOVUS Email / Campaigns (Instantly as the execution layer) ───────────────
# novus/campaigns.html + lib/campaign-*.mjs + lib/instantly-client.mjs.
#
# INSTANTLY_API_KEY is the WRITE key the campaign layer uses to create
# campaigns, add leads, activate and pause (scopes: campaigns:all, leads:all,
# accounts:read, emails:read). It is the same variable the legacy OUTBOUND
# handoff (docs/INSTANTLY_OUTBOUND.md) already uses. Read-only operations
# (list/analytics/sync) fall back to INSTANTLY_REPLY_API_KEY when the write
# key is absent. Server-side only; never in browser code.
INSTANTLY_API_KEY=
INSTANTLY_REPLY_API_KEY=
#
# REQUIRED for automatic sync on Instantly's Growth plan (no webhooks there —
# see docs/EMAIL_CAMPAIGNS.md "## Polling"). Shared secret the external
# ~10-15 minute scheduler (a free GitHub Actions workflow,
# .github/workflows/campaign-sync-poll.yml, is already in this repo) sends as
# X-Novus-Campaign-Poller-Secret when calling
# POST /api/novus/personalisation?novus_operation=campaign-sync-poll.
# Set the SAME value as this project's GitHub Actions repo secret of the
# same name. Without it, campaigns still work fully via the "Sync Now"
# button and the nightly reconciliation — just not automatically.
NOVUS_CAMPAIGN_POLLER_SECRET=change-me-to-something-strong
#
# OPTIONAL — only usable on Instantly's Hyper Growth plan or above, which is
# the only Instantly tier with webhooks. Growth-plan workspaces (the normal
# case for this project) can leave this unset entirely; polling above is the
# real-time sync path either way, and nothing requires this to be configured.
# If you do have Hyper Growth: shared secret for Instantly → NOVUS webhooks.
# Instantly cannot sign payloads but can attach custom headers, so create the
# webhook in Instantly (Settings → Integrations → Webhooks, or
# POST /api/v2/webhooks) with:
#   target_hook_url : https://<NOVUS_PUBLIC_BASE_URL>/api/novus/webhooks/instantly
#   event_type      : all_events   (or one webhook per event you want)
#   headers         : { "X-Novus-Instantly-Secret": "<this value>" }
# The route is under /api/novus/webhooks/*, so middleware.js skips Basic Auth
# and lib/campaign-handlers.mjs compares this header in constant time.
INSTANTLY_WEBHOOK_SECRET=

# ── Anthropic (server-side only) ──────────────────────────────────────────────
# NOVUS_PRODUCTION_API is for Vercel Production only.
# NOVUS_DEVELOPMENT_API is for Vercel Preview plus local/manual rebuilds and tests.
# Never expose either variable to browser code or use a client-exposed prefix.
NOVUS_PRODUCTION_API=
NOVUS_DEVELOPMENT_API=

# ── Existing scraper demo (unchanged) ─────────────────────────────────────────
# BRIGHTDATA_KEY=...
# BRIGHTDATA_ZONE=web_unlocker1
