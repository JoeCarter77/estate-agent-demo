{
  "routes": [
    { "src": "^/$", "dest": "/site/index.html" }
  ],
  "rewrites": [
    { "source": "/assets/:path*", "destination": "/site/assets/:path*" },
    { "source": "/capture", "destination": "/capture.html" },
    { "source": "/privacy", "destination": "/site/privacy.html" },
    { "source": "/terms", "destination": "/site/terms.html" },
    { "source": "/demo/grade-c", "destination": "/grade-c-demo.html" },
    { "source": "/demo/:demo_slug", "destination": "/demo.html" },
    { "source": "/novus", "destination": "/novus/probe.html" },
    { "source": "/novus/probe", "destination": "/novus/probe.html" },
    { "source": "/novus/operator", "destination": "/novus/operator.html" },
    { "source": "/novus/communications", "destination": "/novus/communications.html" },
    { "source": "/novus/calling", "destination": "/novus/calling.html" },
    { "source": "/novus/campaigns", "destination": "/novus/campaigns.html" },
    { "source": "/novus/meetings", "destination": "/novus/meetings.html" },
    { "source": "/api/novus/contacts/verify", "destination": "/api/novus/personalisation?novus_operation=verify-contact" },
    { "source": "/api/novus/contacts/resolve", "destination": "/api/novus/personalisation?novus_operation=resolve-contact" },
    { "source": "/api/novus/contacts/resolution-backlog", "destination": "/api/novus/personalisation?novus_operation=resolution-backlog" },
    { "source": "/api/novus/instantly/replies-test", "destination": "/api/novus/personalisation?novus_operation=instantly-replies-test" },
    { "source": "/api/novus/instantly/reply-poll-dry-run", "destination": "/api/novus/personalisation?novus_operation=instantly-reply-poll-dry-run" },
    { "source": "/api/novus/instantly/reply-poll", "destination": "/api/novus/personalisation?novus_operation=instantly-reply-poll" },
    { "source": "/api/novus/instantly/reply-reconcile", "destination": "/api/novus/personalisation?novus_operation=instantly-reply-reconcile" },
    { "source": "/api/novus/instantly/send-demo-dry-run", "destination": "/api/novus/personalisation?novus_operation=send-demo-dry-run" },
    { "source": "/api/novus/instantly/send-demo", "destination": "/api/novus/personalisation?novus_operation=send-demo" },
    { "source": "/api/novus/operator/leads", "destination": "/api/novus/personalisation?novus_operation=operator-leads" },
    { "source": "/api/novus/operator/conversation", "destination": "/api/novus/personalisation?novus_operation=operator-conversation" },
    { "source": "/api/novus/webhooks/voice-outbound", "destination": "/api/novus/personalisation?novus_operation=twilio-voice-outbound" },
    { "source": "/api/novus/webhooks/voice-outbound-status", "destination": "/api/novus/personalisation?novus_operation=twilio-voice-status" },
    { "source": "/api/novus/webhooks/voice-outbound-recording", "destination": "/api/novus/personalisation?novus_operation=twilio-voice-recording" },
    { "source": "/api/novus/webhooks/voice-inbound-action", "destination": "/api/novus/personalisation?novus_operation=twilio-voice-inbound-action" },
    { "source": "/api/novus/webhooks/instantly", "destination": "/api/novus/personalisation?novus_operation=instantly-webhook" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/d/(.*)", "destination": "/index.html" },
    { "source": "/:demo_slug((?!api$|demo$|novus$|capture$|privacy$|terms$|d$)[^/]+)", "destination": "/demo.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/novus/intelligence/finalize",
      "schedule": "0 3 * * *"
    }
  ]
}
